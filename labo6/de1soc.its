/dts-v1/;

/ {
	description = "Kernel and rootfs components for Altera DE1-SoC 32-bit environment";

	images {

		linux {
			description = "Linux kernel";
			data = /incbin/("/home/baer/linux-6.18/arch/arm/boot/zImage");
			type = "kernel";
			arch = "arm";
			os = "linux";
			compression = "none";
			load = <0x00008000>;
			entry = <0x00008000>;
		};

		fdt {
			description = "Linux device tree blob";
			data = /incbin/("/home/baer/linux-6.18/arch/arm/boot/dts/intel/socfpga/socfpga_cyclone5_de1_soc.dtb");
			type = "flat_dt";
			arch = "arm";
			compression = "none";
			load = <0x10a00000>;
		};
	};

	configurations {
		default = "linux";

		linux {
			description = "Linux on Altera DE1-SoC 32-bit";
			kernel = "linux";
			fdt = "fdt";
		};
	};
};

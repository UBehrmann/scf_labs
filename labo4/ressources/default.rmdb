<?xml version="1.0"?>
<rmdb version="1.0" toprunnables="directed">
  <!-- ============== -->
  <!-- DIRECTED TESTS -->
  <!-- ============== -->
  <runnable name="directed" type="group">
    <parameters>
      <parameter name="ucdbfile">../(%INSTANCE%).ucdb</parameter>
      <parameter name="mergefile">(%DATADIR%)/merge.ucdb</parameter>
    </parameters>
    <members>
      <member>dirtest8__16_0</member>
      <member>dirtest8__16_1</member>
      <member>dirtest8__16_2</member>
      <member>dirtest8__16_3</member>
      <member>dirtest8__16_4</member>
      <member>dirtest8__16_5</member>
      <member>dirtest8__16_6</member>
      <member>dirtest8__16_7</member>
      <member>dirtest8__16_8</member>
      <member>dirtest8__16_0</member>
      <member>dirtest8__16_10</member>
      <member>dirtest8__16_11</member>
      <member>dirtest8__16_12</member>
      <member>dirtest8__16_13</member>
    </members>

    <execScript>
      <command>file delete -force work</command>
      <command>set Path_DUV     "(%RMDBDIR%)/src_vhdl"</command>
      <command>set Path_TB       "(%RMDBDIR%)/src_tb"</command>
      <command>global Path_DUV</command>
      <command>global Path_TB</command>
      <command>vlib work</command>
      <command>vcom -2008 $Path_DUV/log_pkg.vhd</command>
      <command>vcom -2008 +cover $Path_DUV/fifo.vhd</command>
      <command>vcom -2008 $Path_TB/random_pkg.vhd</command>
      <command>vcom -2008 $Path_TB/fifo_tb.vhd</command>
      <command>vsim -coverage -t 10ps -GDATASIZE=(%datasize%) -GFIFOSIZE=(%fifosize%) -GTESTCASE=(%testcase%) work.fifo_tb</command>
      <command>set StdArithNoWarnings 1</command>
      <command>set NumericStdNoWarnings 1</command>
      <command>run 2 ns</command>
      <command>set StdArithNoWarnings 0</command>
      <command>set NumericStdNoWarnings 0</command>
      <command>run -all</command>
      <command>coverage attribute -name (%errno%) -value (%INSTANCE%)</command>
      <command>coverage save (%ucdbfile%)</command>
    </execScript>
  </runnable>
  <runnable name="dirtest8__16_0" type="task">
